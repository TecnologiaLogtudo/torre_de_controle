# Configurações Globais do FastAPI
PROJECT_NAME="Torre de Controle Logtudo"
ENVIRONMENT=desenvolvimento
API_V1_STR=/api/v1
TIMEZONE=America/Bahia

# Configurações do PostgreSQL (Localhost para desenvolvimento no host local)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_logtudo_senha_segura
POSTGRES_DB=torre_de_controle
POSTGRES_PORT=5432

# URL de Conexão do SQLAlchemy para o Host Local
DATABASE_URL=postgresql+psycopg://postgres:postgres_logtudo_senha_segura@localhost:5432/torre_de_controle

# Configurações de Segurança e JWT
JWT_SECRET_KEY=945fa8b309db809f40824b22c7a3c3065a7e12726bbefb8c199583bcf3d84950
JWT_ALGORITHM=HS256
