# ==================== OBRIGATORIAS (sem default - defina no Coolify) ====================
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ROOT_PATH=

# ==================== OPCIONAIS (ja tem default seguro) ====================

# Configuracoes Globais do FastAPI
# PROJECT_NAME="Torre de Controle Logtudo"
# ENVIRONMENT=desenvolvimento
# API_V1_STR=/api/v1
# TIMEZONE=America/Bahia

# Configuracoes do PostgreSQL
# POSTGRES_SERVER=db
# POSTGRES_USER=postgres
# POSTGRES_DB=torre_de_controle
# POSTGRES_PORT=5432

# URL de Conexao do SQLAlchemy (montada automaticamente se nao informada)
# So defina se for usar banco externo ou container com outro hostname no Coolify
# DATABASE_URL=postgresql+psycopg://postgres:senha@postgres:5432/torre_de_controle

# JWT
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (vazio = permite tudo)
# BACKEND_CORS_ORIGINS=http://localhost:5173,https://meusite.com

# Frontend (URL base da API do Backend para a SPA React em producao/docker)
# VITE_API_URL=http://localhost:8000